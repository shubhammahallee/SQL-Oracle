---Find the porn stars who have 'Pink' as pussycolor and nipplecolor (using DeepDetails table). Also show their pornStarName, pornCategory, and rating.
SELECT 
    dd.pussycolor,
    dd.nipplecolor,
    ph.pornStarName,
    c.pornCategory,
    c.rating
FROM PornHub ph
JOIN DeepDetails dd ON dd.pornStarID = ph.pornStarID
JOIN categories c ON c.pornStarWorkID = ph.pornStarWorkID   
WHERE dd.pussycolor = 'Pink'  
  AND dd.nipplecolor = 'Pink';


---Write a query to show pornStarName, totalVideos, perVideoCharge, and calculate estimated total earnings (totalVideos * perVideoCharge). Show only those whose estimated earnings are greater than their totalNetWorth.
SELECT 
    ph.pornStarName,
    pd.totalVideos,
    pd.perVideoCharge,
    (pd.totalVideos * pd.perVideoCharge) AS estimated_total_earnings,
    pd.totalNetWorth
FROM PornHub ph
JOIN personalDetails pd 
    ON ph.pornStarID = pd.pornStarWorkID
WHERE (pd.totalVideos * pd.perVideoCharge) > pd.totalNetWorth
ORDER BY estimated_total_earnings DESC;
