---pornStarName pornCategory salary totalNetWorth pussytype nipplesize Rank the stars by totalNetWorth in descending order.
SELECT
    ph.pornStarName,
    c.pornCategory,
    pd.salary,
    pd.totalNetWorth,
    dd.pussytype,
    dd.nipplesize,
    
    RANK() OVER (
        ORDER BY pd.totalNetWorth DESC
    ) AS rn
FROM PornHub ph
JOIN personalDetails pd
    ON ph.pornStarID = pd.pornStarWorkID
JOIN categories c
    ON c.pornStarWorkID = ph.pornStarID

---Write a query to find the most popular nationality (highest count of porn stars) and show the average rating of videos from that nationality.
select ph.pornstarnationality,count(ph.pornstarnationality) as total_count,
       avg(c.rating) as avg_rating
from pornhub ph JOIN categories c
    ON c.pornStarWorkID = ph.pornStarID
group by ph.pornstarnationality;

