---Find the porn stars who have 'Pink' as pussycolor and nipplecolor (using DeepDetails table). Also show their pornStarName, pornCategory, and rating.
SELECT 
    dd.pussycolor,
    dd.nipplecolor,
    ph.pornStarName,
    c.pornCategory,
    c.rating
FROM PornHub ph
JOIN DeepDetails dd ON dd.pornStarID = ph.pornStarID
JOIN categories c ON c.pornStarWorkID = ph.pornStarWorkID   
WHERE dd.pussycolor = 'Pink' 
  AND dd.nipplecolor = 'Pink';


