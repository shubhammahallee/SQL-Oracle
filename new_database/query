---Update the salary of all stars by 10% whose rating is 5.
UPDATE personalDetails pd
SET pd.salary = pd.salary + (pd.salary * 0.10)
WHERE pd.pornStarWorkID IN (
    SELECT c.pornStarWorkID
    FROM categories c
    WHERE c.rating = 5
);


---Delete all records of stars who have less than 100 totalVideos and rating less than 4.
SELECT 
    ph.pornStarName,
    pd.totalVideos,
    c.rating
FROM PornHub ph
JOIN personalDetails pd
    ON ph.pornStarID = pd.pornStarWorkID
JOIN categories c
    ON c.pornStarWorkID = ph.pornStarID
WHERE pd.totalVideos < 100
AND c.rating < 4;


---Find the average age of porn stars grouped by their pornStarNationality. Show only nationalities with more than 2 stars.
select ph.pornStarNationality,
      avg(pd.currentage) as avg_age,
      count(ph.pornStarNationality) as count
FROM PornHub ph
JOIN personalDetails pd
    ON ph.pornStarID = pd.pornStarWorkID
GROUP by ph.pornStarNationality;
