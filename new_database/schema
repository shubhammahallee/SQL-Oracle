CREATE TABLE PornHub (
    pornStarID NUMBER PRIMARY KEY,
    pornStarName VARCHAR2(50) NOT NULL,
    pornStarAge NUMBER CHECK (pornStarAge > 18),
    pornStarBirthPlace VARCHAR2(100) NOT NULL,
    pornStarBoobSize VARCHAR2(10) NOT NULL,
    pornStarWaistSize VARCHAR2(10) NOT NULL,
    pornStarHipSize VARCHAR2(10) NOT NULL,
    pornStarHeight VARCHAR2(10) NOT NULL,
    pornStarWeight VARCHAR2(10) NOT NULL,
    pornStarNationality VARCHAR2(50) NOT NULL,
    pornStarWorkID NUMBER,
    CONSTRAINT fk_work
        FOREIGN KEY (pornStarWorkID)
        REFERENCES PornHub(pornStarID)
);

CREATE TABLE categories (
    pornStarWorkID INT PRIMARY KEY,
    pornCategory VARCHAR2(100) NOT NULL,
    pornVideosAvailable VARCHAR2(100) NOT NULL,
    pornType VARCHAR2(100) NOT NULL,
    videoTime INT,
    rating INT,
    
    CONSTRAINT fk_category
    FOREIGN KEY (pornStarWorkID)
    REFERENCES PornHub(pornStarID)
);


CREATE TABLE personalDetails (
    pornStarWorkID INT PRIMARY KEY,
    DOJ DATE,
    salary NUMBER(10,2),
    totalVideos INT,
    perVideoCharge INT,
    currentAge INT,
    ageAtJoiningTime INT,
    totalNetWorth NUMBER(12,2)
);



