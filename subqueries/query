    SELECT CUSTOMER_ID,Order_Date
    FROM Orders
    WHERE Order_Date < TO_DATE('15-01-2024','DD-MM-YYYY')
    group by CUSTOMER_NAME,CUSTOMER_ID,Order_Date
);
