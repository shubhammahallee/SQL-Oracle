---Basic Subqueries
---1.Retrieve all customers who have placed an order.
SELECT * FROM customers WHERE customer_id IN ( SELECT customer_id FROM orders);

---2.Find customers who have not placed any orders.
SELECT * FROM customers WHERE customer_id NOT IN (SELECT customer_id FROM orders WHERE customer_id IS NOT NULL);

---3.Get the names of customers whose total purchase is greater than the average order amount.
SELECT customer_name FROM customers
WHERE total_purchase > ( SELECT AVG(order_amount)  FROM orders);

---4.Retrieve customers who have placed an order with the status 'Delivered'.
SELECT * FROM customers WHERE customer_id IN (SELECT customer_id FROM orders WHERE status = 'Delivered');

---5.Find the orders where the amount is greater than the total purchase of customer_id = 5.
SELECT * FROM orders WHERE order_amount > (SELECT total_purchase FROM customers WHERE customer_id = 5);

---Subqueries with Operators
---6.Retrieve customers whose age is greater than the average age of all customers.
select * from CUSTOMERS where age >(SELECT avg(Age) FROM Customers);

---7.Find orders where the amount is greater than the average order amount.
select * from Orders where Order_Amount >(SELECT avg(Order_Amount) FROM Orders);

---8.Get customers who have placed more than one order.
SELECT Customer_ID FROM Orders GROUP BY Customer_ID HAVING COUNT(*) > 1;

---9.Retrieve orders placed by customers from 'New York'.
SELECT *  FROM Orders WHERE Customer_ID IN (SELECT Customer_ID  FROM Customers  WHERE City = 'New York');

---10.Find orders placed in the last 30 days using a subquery.
SELECT *  FROM Orders WHERE Order_Date >= (SELECT SYSDATE - 30 FROM dual);

---Subqueries with Aggregate Functions
---Find the maximum order amount placed by customers.
SELECT * FROM orders WHERE order_amount = (SELECT MAX(order_amount) FROM orders);

---Retrieve the customer who has the highest total purchase.
SELECT * FROM Customers WHERE Total_Purchase = (SELECT MAX(Total_Purchase) FROM Customers);

---Get the average order amount for each customer.
SELECT * FROM orders WHERE order_amount = (SELECT avg(order_amount) FROM orders);

SELECT customer_id, AVG(order_amount) AS avg_order_amount FROM orders GROUP BY customer_id;

---Find the total amount of orders placed by customers aged above 40.
SELECT SUM(Order_Amount) AS Total_Amount FROM Orders WHERE Customer_ID IN (SELECT Customer_ID FROM Customers WHERE Age > 40);

---Retrieve the minimum order amount for each status.
SELECT Status, MIN(Order_Amount) AS Min_Amount FROM Orders GROUP BY Status;
