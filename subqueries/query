-- 1. Find orders where the amount is greater than the average order amount for that customer.
select * from ORDERS
where Order_Amount >(select avg(Order_Amount) from ORDERS);

-- 2. Get customers who have placed orders with a status of 'Delivered' more than once.
SELECT customer_id FROM orders WHERE status = 'Delivered'
GROUP BY customer_id HAVING COUNT(*) > 1;

-- 3. Retrieve orders where the amount is greater than the total purchase of the customer who placed it.
SELECT Order_ID, Customer_ID
FROM orders o
WHERE Order_amount > (
    SELECT Total_Purchase
    FROM customers c
    WHERE c.Customer_ID = o.Customer_ID
);

-- 4. Find customers who have placed an order within the last 7 days.
SELECT DISTINCT c.*
FROM Customers c
JOIN Orders o
ON c.Customer_ID = o.Customer_ID
WHERE o.Order_Date >= SYSDATE - 7;

-- 5. Retrieve the name and total purchase of customers who have placed an order but not in the last month.
SELECT c.Customer_Name, c.Total_Purchase
FROM Customers c
JOIN Orders o
ON c.Customer_ID = o.Customer_ID
GROUP BY c.Customer_Name, c.Total_Purchase
HAVING MAX(o.Order_Date) < SYSDATE - 30;

-- 6. Find orders placed by customers who have the minimum total purchase.
select min(total_purchase) from CUSTOMERS where CUSTOMER_ID IN (select CUSTOMER_ID from ORDERS);


-- 7. Retrieve orders where the amount is greater than the sum of all orders for 'Cancelled' status.
SELECT c.Customer_Name, o.Order_Amount, o.Status
FROM Customers c
JOIN Orders o
ON c.Customer_ID = o.Customer_ID
WHERE o.Order_Amount > (
    SELECT SUM(Order_Amount)
    FROM Orders
    WHERE Status = 'Cancelled'
);

