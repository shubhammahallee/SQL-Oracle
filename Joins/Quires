----Users who never made a payment---
SELECT u.full_name,
       p.amount,
       t.status
FROM users u
JOIN payments p
  ON u.user_id = p.user_id
JOIN (
        SELECT *
        FROM transactions
        WHERE status = 'FAILED'
     ) t
  ON p.payment_id = t.payment_id;

SELECT u.full_name, p.amount, t.status
FROM users u
JOIN payments p ON u.user_id = p.user_id
JOIN transactions t ON p.payment_id = t.payment_id
WHERE t.status = 'FAILED';

----Users who made more than average payment--
SELECT u.full_name, p.amount
FROM users u
JOIN payments p
  ON u.user_id = p.user_id
WHERE p.amount > (SELECT AVG(amount) FROM payments);

----User name with payment amount---
select u.full_name,p.amount from users u
join payments p ON u.user_id = p.user_id;

---User-wise total amount spent---
select u.full_name,p.amount from users u
join payments p ON u.user_id = p.user_id;

----Merchant-wise transaction count
SELECT m.merchant_id,
       m.merchant_name,
       COUNT(p.payment_id) AS txn_count
FROM merchants m
JOIN payments p
  ON m.merchant_id = p.merchant_id
GROUP BY m.merchant_id, m.merchant_name;
