----Users who never made a payment---
SELECT u.full_name,
       p.amount,
       t.status
FROM users u
JOIN payments p
  ON u.user_id = p.user_id
JOIN (
        SELECT *
        FROM transactions
        WHERE status = 'FAILED'
     ) t
  ON p.payment_id = t.payment_id;

SELECT u.full_name, p.amount, t.status
FROM users u
JOIN payments p ON u.user_id = p.user_id
JOIN transactions t ON p.payment_id = t.payment_id
WHERE t.status = 'FAILED';

----Users who made more than average payment--
SELECT u.full_name, p.amount
FROM users u
JOIN payments p
  ON u.user_id = p.user_id
WHERE p.amount > (SELECT AVG(amount) FROM payments);
