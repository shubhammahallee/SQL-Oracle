---Basic Aggregate Functions
---1. Find the total count of distinct manufacturers in the table.
SELECT distinct manufacturer from Product;

---2. Calculate the total price of all products where the Product_Type is 'Furniture'.
select sum(price) from PRODUCT where Product_Type ='Furniture';

---3. Find the average price of all products whose SellerName is 'TechWorld'.
select AVG(price) from PRODUCT where SellerName = 'TechWorld';

---4. Determine the maximum price of products sold by 'AudioStore'.
select max(price) from PRODUCT where SellerName = 'AudioStore';

---5. Find the minimum price of any product in the Appliances category.
select min(price) from PRODUCT where Product_Type ='Appliances';

---6. Calculate the average price of products where the Manufacturer is 'HP'.
select AVG(price) from PRODUCT where manufacturer = 'HP';

---7. Count how many products are sold by 'GadgetHub'.
select count(Product_ID) from PRODUCT where SellerName ='GadgetHub';

---8. Find the total price of all products with the Product_Name containing 'Drive'.
select sum(price) from PRODUCT where Product_Name LIKE'%Drive%';

---9. Determine the minimum price among products that start with 'S' in Product_Type.
select min(price) from PRODUCT where Product_Type LIKE'S%';

---10.Calculate the total price of all products sold by sellers whose name ends with 'Store'.
select sum(price) from PRODUCT where SellerName LIKE'%Store';

---Group By with Aggregate Functions
---11. Find the total price of products grouped by Manufacturer.
select Manufacturer,sum(price) from PRODUCT GROUP BY Manufacturer;

---12.Calculate the average price of products grouped by SellerName.
select SellerName,avg(price) from PRODUCT GROUP BY SellerName;

---13.Retrieve the maximum price of products grouped by Product_Type.
select Product_Type,max(price) from PRODUCT GROUP BY Product_Type;

---14.Count the total number of products grouped by Product_Type and Manufacturer.
select Manufacturer,Product_Type,count(Product_ID) from PRODUCT GROUP BY Product_Type,Manufacturer;

---15.Determine the minimum price of products grouped by Product_Type where Manufacturer is 'Samsung'.
SELECT Manufacturer,
       Product_Type,
       MIN(price) AS min_price
FROM product
WHERE Manufacturer = 'Samsung'
GROUP BY Manufacturer, Product_Type;
