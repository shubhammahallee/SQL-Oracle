---Basic Aggregate Functions
---1. Find the total count of distinct manufacturers in the table.
SELECT distinct manufacturer from Product;

---2. Calculate the total price of all products where the Product_Type is 'Furniture'.
select sum(price) from PRODUCT where Product_Type ='Furniture';

---3. Find the average price of all products whose SellerName is 'TechWorld'.
select AVG(price) from PRODUCT where SellerName = 'TechWorld';

---4. Determine the maximum price of products sold by 'AudioStore'.
select max(price) from PRODUCT where SellerName = 'AudioStore';

---5. Find the minimum price of any product in the Appliances category.
select min(price) from PRODUCT where Product_Type ='Appliances';

---6. Calculate the average price of products where the Manufacturer is 'HP'.
select AVG(price) from PRODUCT where manufacturer = 'HP';

---7. Count how many products are sold by 'GadgetHub'.
select count(Product_ID) from PRODUCT where SellerName ='GadgetHub';

---8. Find the total price of all products with the Product_Name containing 'Drive'.
select sum(price) from PRODUCT where Product_Name LIKE'%Drive%';

---9. Determine the minimum price among products that start with 'S' in Product_Type.
select min(price) from PRODUCT where Product_Type LIKE'S%';

---10.Calculate the total price of all products sold by sellers whose name ends with 'Store'.
select sum(price) from PRODUCT where SellerName LIKE'%Store';

---Group By with Aggregate Functions
---11. Find the total price of products grouped by Manufacturer.
select Manufacturer,sum(price) from PRODUCT GROUP BY Manufacturer;

---12.Calculate the average price of products grouped by SellerName.
select SellerName,avg(price) from PRODUCT GROUP BY SellerName;

---13.Retrieve the maximum price of products grouped by Product_Type.
select Product_Type,max(price) from PRODUCT GROUP BY Product_Type;

---14.Count the total number of products grouped by Product_Type and Manufacturer.
select Manufacturer,Product_Type,count(Product_ID) from PRODUCT GROUP BY Product_Type,Manufacturer;

---15.Determine the minimum price of products grouped by Product_Type where Manufacturer is 'Samsung'.
SELECT Manufacturer,
       Product_Type,
       MIN(price) AS min_price
FROM product
WHERE Manufacturer = 'Samsung'
GROUP BY Manufacturer, Product_Type;

---16. Find the total number of products and their sum of prices grouped by SellerName.
select SellerName,COUNT(Product_ID) AS total_products,
       SUM(price) AS total_price FROM product group by SellerName;

---17.Calculate the average and total price of products grouped by Product_Type and SellerName.
select Product_Type,SellerName,avg(price) AS average_price,
       SUM(price) AS total_price FROM product group by SellerName,Product_Type;

---18. Find the maximum and minimum price of products grouped by Manufacturer.
select Manufacturer,min(price) AS min_price,
       max(price) AS max_price FROM product group by Manufacturer;

---19.Count the number of products for each Manufacturer where the price is greater than 100. 
select Manufacturer,price,COUNT(Product_ID) AS total_products
        FROM product where price > 100 group by Manufacturer,price;

---20.Calculate the average price of products grouped by Product_Type where SellerName contains 'Home'.
select Product_Type,SellerName,avg(price) AS average_price
FROM product where SellerName LIKE '%Home%' group by SellerName,Product_Type;

---Using Conditions with Aggregate Functions
---21. Find the total price of all products where the price is greater than the average price of all products.
SELECT SUM(price) AS total_price FROM product
HAVING SUM(price) > (SELECT AVG(price) FROM product);

---22.Count how many products have a price less than the maximum price in the Electronics category.
SELECT COUNT(Product_ID) AS total_products FROM product
where price < (SELECT max(price) FROM product where Product_Type = 'Electronics');

---23.Determine the sum of prices for products where the Product_Name starts with 'M'.
select Product_Name,sum(price) as total_price from product where Product_Name LIKE 'M%' GROUP by Product_Name;

---24.Calculate the average price of products sold by sellers whose name contains 'Tech'.
select SellerName,avg(price) as avg_price from product where SellerName LIKE '%Tech%' GROUP by SellerName;

---25. Find the total number of products and their sum of prices where the Manufacturer is not 'Samsung'.
select Manufacturer,sum(price) as avg_price from product where Manufacturer <> 'Samsung' GROUP by Manufacturer;

---26. Find the maximum price among products where the Product_Type is not 'Accessories'.
select Product_Type,max(price) as max_price from product where Product_Type <> 'Accessories' GROUP by Product_Type;

---27.Count how many products are sold by 'PC Parts' where the price is greater than the average price of all products.
select Product_Type,count(Product_ID) as total_count from product where Product_Type <> 'PC Parts' GROUP by Product_Type;

---28.Calculate the sum of prices for products grouped by Manufacturer where the total price exceeds 500.
SELECT Manufacturer, SUM(price) AS total_price FROM product GROUP BY Manufacturer HAVING SUM(price) > 500;

---29.Determine the maximum and minimum price of products grouped by SellerName where the Product_Type is 'Storage'.
select SellerName,max(price)as max_price,min(price) as min_price from product where Product_Type  = 'Storage' group by SellerName;

---30.Count the number of products whose price is between 50 and 500 and group them by Product_Type.
SELECT price,Product_Type,count(Product_ID) as count_product FROM product where price between 50 AND 500 GROUP BY Product_Type,price;

---ORDER BY Clause (Sorting Data)
---31.Retrieve all products and order them by Price in ascending order.
select Product_ID,Product_Name,price from product ORDER by price ASC;

---32.Display all products and sort them by Product_Name in descending order.
select * from product ORDER by Product_Name DESC;

---33.Retrieve all products and order them by Product_Type, then by Price within each type.
SELECT * FROM product ORDER BY Product_Type, Price;

---34.Display all products where the Manufacturer is 'Samsung' and sort by SellerName in ascending order.
SELECT * FROM product where Manufacturer = 'Samsung' ORDER by SellerName ASC;

---35. List all products with a Price greater than 100 and sort by Price in descending order.
SELECT * FROM product where Price > 100 ORDER by Price DESC;

---36.Retrieve all products and sort by Manufacturer, then by Product_Name within each manufacturer.
SELECT * FROM product  ORDER by Manufacturer,Product_Name ;

---37.Display all products where the Product_Type is 'Electronics' and order by Price in ascending order.
SELECT * FROM product where Product_Type = 'Electronics' ORDER by Price asc;

---38.Retrieve all products where the SellerName contains 'Home' and sort by Product_Type in descending order.
SELECT * FROM product where SellerName = 'Home' ORDER by Product_Type desc;

---39. List all products and sort by Manufacturer in ascending order, then by Price in descending order.
SELECT * FROM product ORDER by  Manufacturer asc, Price desc;

---40.Retrieve all products and sort by SellerName, Manufacturer, and Price.
SELECT * FROM product ORDER by SellerName, Manufacturer, Price;


